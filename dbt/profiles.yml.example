nyc_taxi:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_POSTGRES_HOST', 'localhost') }}"
      user: "{{ env_var('POSTGRES_USER', 'taxi') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'taxi') }}"
      port: 5432
      dbname: "{{ env_var('POSTGRES_DB', 'nyc_taxi') }}"
      schema: analytics
      threads: 4
